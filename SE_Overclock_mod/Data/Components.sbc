            <DisplayName>Defense Module Lv 1</DisplayName>
            <Description>To apply the upgrade module, rename the cockpit block with an inventory to include '[Upgrade]' in its name, and place the module in the block's inventory. Only one module of each type can be applied. Defense level +1.</Description>
            <Icon>Textures\GUI\Icons\component\modules\defense-01.dds</Icon>
            <Size>
                <X>0.1</X>
                <Y>0.1</Y>
                <Z>0.1</Z>
            </Size>
            <Mass>1</Mass>
            <Volume>1</Volume>
            <MinimalPricePerUnit>1000000</MinimalPricePerUnit>
            <MinimumOfferAmount>10</MinimumOfferAmount>
            <MaximumOfferAmount>50</MaximumOfferAmount>
            <MinimumOrderAmount>10</MinimumOrderAmount>
            <MaximumOrderAmount>50</MaximumOrderAmount>
            <CanPlayerOrder>true</CanPlayerOrder>
            <MinimumAcquisitionAmount>5</MinimumAcquisitionAmount>
            <MaximumAcquisitionAmount>25</MaximumAcquisitionAmount>
            <DropProbability>0</DropProbability>
            <Model>Models\Components\computer_component.mwm</Model>
